+func TestManager_InvalidGrantBadRequestIsNotRequestInvalid(t *testing.T) {
+	err := &Error{
+		HTTPStatus: http.StatusBadRequest,
+		Message:    `{"type":"invalid_request_error","error":{"error":"invalid_grant"}}`,
+	}
