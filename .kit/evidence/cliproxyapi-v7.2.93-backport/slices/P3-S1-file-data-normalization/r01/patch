+func TestConvertOpenAIRequestToCodexNormalizesFileData(t *testing.T) {
+	tests := []struct {
+		name         string
+		filename     string
+		fileData     string
+		wantFileData string
+		wantOK       bool
+	}{
+		{name: "raw data uses filename fallback", filename: "TEST.PDF", fileData: "not-base64!?", wantFileData: "data:application/pdf;base64,not-base64!?", wantOK: true},
+		{name: "explicit MIME is authoritative", filename: "test.txt", fileData: "DATA:image/png;charset=utf-8;BaSe64,%%%not-base64%%%", wantFileData: "data:image/png;base64,%%%not-base64%%%", wantOK: true},
+		{name: "malformed data URL", filename: "test.pdf", fileData: "data:application/pdf;base64"},
+		{name: "MIME-less data URL", filename: "test.pdf", fileData: "data:;base64,payload"},
+		{name: "non-base64 data URL", filename: "test.pdf", fileData: "data:application/pdf,payload"},
+		{name: "empty data", filename: "test.pdf"},
+		{name: "payload-less data URL", filename: "test.pdf", fileData: "data:application/pdf;base64,"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			input := []byte(fmt.Sprintf(`{"messages":[{"role":"user","content":[{"type":"file","file":{"filename":%q,"file_data":%q}}]}]}`, test.filename, test.fileData))
+			out := ConvertOpenAIRequestToCodex("gpt-5", input, true)
+			parts := gjson.GetBytes(out, "input.0.content").Array()
+			if !test.wantOK {
+				if len(parts) != 0 {
+					t.Fatalf("expected invalid file data to be skipped, got %s", gjson.GetBytes(out, "input.0.content").Raw)
+				}
+				return
+			}
+			if len(parts) != 1 {
+				t.Fatalf("expected one file part, got %d: %s", len(parts), out)
+			}
+			if got := parts[0].Get("type").String(); got != "input_file" {
+				t.Fatalf("type = %q, want input_file: %s", got, out)
+			}
+			if got := parts[0].Get("file_data").String(); got != test.wantFileData {
+				t.Fatalf("file_data = %q, want %q: %s", got, test.wantFileData, out)
+			}
+		})
+	}
+}
