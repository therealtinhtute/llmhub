+package common
+
+import "testing"
+
+func TestNormalizeOpenAIFileData(t *testing.T) {
+	tests := []struct {
+		name         string
+		filename     string
+		fallbackMIME string
+		fileData     string
+		wantMIMEType string
+		wantData     string
+		wantOK       bool
+	}{
+		{
+			name:         "raw data uses supplied fallback first",
+			filename:     "test.pdf",
+			fallbackMIME: "text/plain",
+			fileData:     "not-base64!?",
+			wantMIMEType: "text/plain",
+			wantData:     "not-base64!?",
+			wantOK:       true,
+		},
+		{
+			name:         "raw data uses lowercase extension lookup",
+			filename:     "TEST.PDF",
+			fileData:     "JVBERi0xLjQK",
+			wantMIMEType: "application/pdf",
+			wantData:     "JVBERi0xLjQK",
+			wantOK:       true,
+		},
+		{
+			name:         "explicit data URL MIME is authoritative",
+			filename:     "test.txt",
+			fallbackMIME: "application/pdf",
+			fileData:     "DATA:image/png;charset=binary; BASE64 ,not@base64!?",
+			wantMIMEType: "image/png",
+			wantData:     "not@base64!?",
+			wantOK:       true,
+		},
+		{
+			name:         "data URL payload preserves commas",
+			fileData:     "data:text/plain;base64,a,b,c",
+			wantMIMEType: "text/plain",
+			wantData:     "a,b,c",
+			wantOK:       true,
+		},
+		{name: "empty input", filename: "test.pdf"},
+		{name: "raw data without fallback", filename: "test.unknown", fileData: "payload"},
+		{name: "malformed data URL without comma", filename: "test.pdf", fileData: "data:application/pdf;base64"},
+		{name: "MIME-less data URL", filename: "test.pdf", fileData: "data:;base64,payload"},
+		{name: "non-base64 data URL", filename: "test.pdf", fileData: "data:application/pdf;charset=utf-8,payload"},
+		{name: "payload-less data URL", filename: "test.pdf", fileData: "data:application/pdf;base64,"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			mimeType, data, ok := NormalizeOpenAIFileData(test.filename, test.fallbackMIME, test.fileData)
+			if mimeType != test.wantMIMEType || data != test.wantData || ok != test.wantOK {
+				t.Fatalf("NormalizeOpenAIFileData() = (%q, %q, %v), want (%q, %q, %v)", mimeType, data, ok, test.wantMIMEType, test.wantData, test.wantOK)
+			}
+		})
+	}
+}
