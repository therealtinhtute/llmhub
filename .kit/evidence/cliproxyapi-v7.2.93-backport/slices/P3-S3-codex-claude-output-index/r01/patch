+	}
+
+	want := []int64{4, 4, 4, 4, 7, 7, 2, 7, 2, 2, 7}
+	if got := claudeContentBlockIndexes(outputs); !equalInt64Slices(got, want) {
+		t.Fatalf("interleaved content block indexes = %v, want %v; outputs=%q", got, want, outputs)
+	}
+}
+
+func claudeContentBlockIndexes(outputs [][]byte) []int64 {
+	var indexes []int64
+	for _, out := range outputs {
+		for _, line := range strings.Split(string(out), "\n") {
+			if !strings.HasPrefix(line, "data: ") {
+				continue
+			}
+			data := gjson.Parse(strings.TrimPrefix(line, "data: "))
+			switch data.Get("type").String() {
+			case "content_block_start", "content_block_delta", "content_block_stop":
+				indexes = append(indexes, data.Get("index").Int())
+			}
+		}
+	}
+	return indexes
+}
+
+func equalInt64Slices(a, b []int64) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
