+		[]byte(`data: {"type":"response.reasoning_summary_part.added","output_index":4}`),
+		[]byte(`data: {"type":"response.reasoning_summary_text.delta","output_index":40,"delta":"think"}`),
+		[]byte(`data: {"type":"response.reasoning_summary_part.done","output_index":40}`),
+		[]byte(`data: {"type":"response.output_item.added","output_index":7,"item":{"type":"function_call","call_id":"call_7","name":"lookup"}}`),
+		[]byte(`data: {"type":"response.content_part.added","output_index":2}`),
+		[]byte(`data: {"type":"response.function_call_arguments.delta","output_index":70,"delta":"{}"}`),
+		[]byte(`data: {"type":"response.output_text.delta","output_index":20,"delta":"answer"}`),
+		[]byte(`data: {"type":"response.content_part.done","output_index":20}`),
+		[]byte(`data: {"type":"response.output_item.done","output_index":70,"item":{"type":"function_call"}}`),
