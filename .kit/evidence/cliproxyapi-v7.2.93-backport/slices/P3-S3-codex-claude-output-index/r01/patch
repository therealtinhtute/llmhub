+func codexOutputIndex(event gjson.Result) (int, bool) {
+	outputIndex := event.Get("output_index")
+	if !outputIndex.Exists() {
+		return 0, false
+	}
+	return int(outputIndex.Int()), true
+}
+
+func setCodexBlockIndex(index *int, indexSet *bool, event gjson.Result, fallback int) int {
+	if *indexSet {
+		return *index
+	}
+	if outputIndex, ok := codexOutputIndex(event); ok {
+		*index = outputIndex
+	} else {
+		*index = fallback
+	}
+	*indexSet = true
+	return *index
+}
