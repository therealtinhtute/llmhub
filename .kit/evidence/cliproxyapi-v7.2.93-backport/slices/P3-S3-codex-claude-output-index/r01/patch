+func TestConvertCodexResponseToClaude_StreamOutputIndexLifecycle(t *testing.T) {
+	tests := []struct {
+		name        string
+		chunks      [][]byte
+		wantIndexes []int64
+	}{
+		{
+			name: "Explicit zero wins after fallback advances",
+			chunks: [][]byte{
+				[]byte(`data: {"type":"response.content_part.added"}`),
+				[]byte(`data: {"type":"response.output_text.delta","delta":"first"}`),
+				[]byte(`data: {"type":"response.content_part.done"}`),
+				[]byte(`data: {"type":"response.content_part.added","output_index":0}`),
+				[]byte(`data: {"type":"response.output_text.delta","output_index":9,"delta":"second"}`),
+				[]byte(`data: {"type":"response.content_part.done","output_index":9}`),
+			},
+			wantIndexes: []int64{0, 0, 0, 0, 0, 0},
+		},
+		{
+			name: "Nonzero provider index stays stable",
+			chunks: [][]byte{
+				[]byte(`data: {"type":"response.output_item.added","output_index":7,"item":{"type":"function_call","call_id":"call_7","name":"lookup"}}`),
+				[]byte(`data: {"type":"response.function_call_arguments.delta","output_index":8,"delta":"{\"q\":"}`),
+				[]byte(`data: {"type":"response.function_call_arguments.done","output_index":8,"arguments":"{\"q\":\"x\"}"}`),
+				[]byte(`data: {"type":"response.output_item.done","output_index":8,"item":{"type":"function_call"}}`),
+			},
+			wantIndexes: []int64{7, 7, 7, 7},
+		},
+		{
+			name: "Absent output index uses sequential fallback",
+			chunks: [][]byte{
+				[]byte(`data: {"type":"response.content_part.added"}`),
+				[]byte(`data: {"type":"response.output_text.delta","delta":"first"}`),
+				[]byte(`data: {"type":"response.content_part.done"}`),
+				[]byte(`data: {"type":"response.output_item.added","item":{"type":"function_call","call_id":"call_2","name":"lookup"}}`),
+				[]byte(`data: {"type":"response.function_call_arguments.delta","delta":"{}"}`),
+				[]byte(`data: {"type":"response.output_item.done","item":{"type":"function_call"}}`),
+			},
+			wantIndexes: []int64{0, 0, 0, 1, 1, 1, 1},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var param any
+			var outputs [][]byte
+			for _, chunk := range tt.chunks {
+				outputs = append(outputs, ConvertCodexResponseToClaude(context.Background(), "", []byte(`{"tools":[{"name":"lookup"}]}`), nil, chunk, &param)...)
+			}
+
+			indexes := claudeContentBlockIndexes(outputs)
+			if got, want := indexes, tt.wantIndexes; !equalInt64Slices(got, want) {
+				t.Fatalf("content block indexes = %v, want %v; outputs=%q", got, want, outputs)
+			}
+		})
+	}
+}
