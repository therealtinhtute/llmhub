+func codexLifecycleForEvent(params *ConvertCodexResponseToClaudeParams, kind string, event gjson.Result, start bool) *codexBlockLifecycle {
+	if params.Lifecycles == nil {
+		params.Lifecycles = make(map[string]*codexBlockLifecycle)
+	}
+
+	stableKeys := codexLifecycleStableKeys(kind, event)
+	for _, key := range stableKeys {
+		if lifecycle := params.Lifecycles[key]; lifecycle != nil && !lifecycle.Removed {
+			captureCodexProviderIndex(lifecycle, event)
+			setActiveCodexLifecycle(params, kind, lifecycle)
+			return lifecycle
+		}
+	}
+
+	outputKey := ""
+	if outputIndex, ok := codexOutputIndex(event); ok {
+		outputKey = kind + ":output:" + strconv.Itoa(outputIndex)
+		if len(stableKeys) == 0 {
+			if lifecycle := params.Lifecycles[outputKey]; lifecycle != nil && !lifecycle.Removed {
+				captureCodexProviderIndex(lifecycle, event)
+				setActiveCodexLifecycle(params, kind, lifecycle)
+				return lifecycle
+			}
+		}
+	}
+
+	if !start && len(stableKeys) == 0 {
+		if lifecycle := activeCodexLifecycle(params, kind); lifecycle != nil && !lifecycle.Removed {
+			captureCodexProviderIndex(lifecycle, event)
+			return lifecycle
+		}
+	}
+
+	lifecycle := &codexBlockLifecycle{}
+	captureCodexProviderIndex(lifecycle, event)
+	keys := append([]string(nil), stableKeys...)
+	if outputKey != "" {
+		keys = append(keys, outputKey)
+	}
+	if len(keys) == 0 {
+		params.AnonymousID++
+		keys = append(keys, kind+":anonymous:"+strconv.Itoa(params.AnonymousID))
+	}
+	for _, key := range keys {
+		params.Lifecycles[key] = lifecycle
+		lifecycle.Keys = append(lifecycle.Keys, key)
+	}
+	if kind == "thinking" {
+		params.ThinkingLifecycles = append(params.ThinkingLifecycles, lifecycle)
+	}
+	setActiveCodexLifecycle(params, kind, lifecycle)
+	return lifecycle
+}
+
+func codexLifecycleStableKeys(kind string, event gjson.Result) []string {
+	values := []struct {
+		prefix string
+		value  string
+	}{
+		{prefix: "id:", value: event.Get("item_id").String()},
+		{prefix: "id:", value: event.Get("item.id").String()},
+		{prefix: "call:", value: event.Get("item.call_id").String()},
+		{prefix: "call:", value: event.Get("call_id").String()},
+	}
+	keys := make([]string, 0, len(values))
+	seen := make(map[string]struct{}, len(values))
+	for _, candidate := range values {
+		if candidate.value == "" {
+			continue
+		}
+		key := kind + ":" + candidate.prefix + candidate.value
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		keys = append(keys, key)
+	}
+	return keys
+}
+
+func captureCodexProviderIndex(lifecycle *codexBlockLifecycle, event gjson.Result) {
+	if lifecycle.ProviderIndexSet {
+		return
+	}
+	if outputIndex, ok := codexOutputIndex(event); ok {
+		lifecycle.ProviderIndex = outputIndex
+		lifecycle.ProviderIndexSet = true
+	}
+}
+
+func selectCodexLifecycleIndex(params *ConvertCodexResponseToClaudeParams, lifecycle *codexBlockLifecycle, event gjson.Result) int {
+	if lifecycle.IndexSet {
+		return lifecycle.Index
+	}
+	captureCodexProviderIndex(lifecycle, event)
+	if lifecycle.ProviderIndexSet {
+		lifecycle.Index = lifecycle.ProviderIndex
+	} else {
+		lifecycle.Index = params.BlockIndex
+	}
+	params.BlockIndex++
+	lifecycle.IndexSet = true
+	return lifecycle.Index
+}
