+	if !errors.As(err, &collision) {
+		t.Fatalf("error = %v, want ResponsesToolNameCollisionError", err)
+	}
+	if collision.EffectiveName != "repo__read" {
+		t.Fatalf("collision effective name = %q, want repo__read", collision.EffectiveName)
+	}
+}
