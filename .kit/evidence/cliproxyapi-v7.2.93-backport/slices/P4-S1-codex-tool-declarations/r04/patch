+	payload := []byte(`{
+		"model":"gpt-5.4",
+		"tools":[{"type":"namespace","name":"repo","tools":[
+			{"type":"function","name":"read","parameters":{"type":"object","properties":{"path":{"type":"string"}}}},
+			{"type":"custom","name":"patch"},
