+type customInputLifecycle struct {
+	itemID      string
+	callID      string
+	name        string
+	outputIndex int
+	arguments   string
+}
+
+func customInputLifecycleMessages(calls []customInputLifecycle) []string {
+	messages := make([]string, 0)
+	for _, call := range calls {
+		event := []byte(`{"type":"response.output_item.added","output_index":0,"item":{"id":"","type":"function_call","call_id":"","name":"","arguments":""}}`)
+		event, _ = sjson.SetBytes(event, "output_index", call.outputIndex)
+		event, _ = sjson.SetBytes(event, "item.id", call.itemID)
+		event, _ = sjson.SetBytes(event, "item.call_id", call.callID)
+		event, _ = sjson.SetBytes(event, "item.name", call.name)
+		messages = append(messages, string(event))
+	}
+	maxLen := 0
+	for _, call := range calls {
+		if len(call.arguments) > maxLen {
+			maxLen = len(call.arguments)
+		}
+	}
+	for i := 0; i < maxLen; i++ {
+		for _, call := range calls {
+			if i >= len(call.arguments) {
+				continue
+			}
+			event := []byte(`{"type":"response.function_call_arguments.delta","item_id":"","output_index":0,"delta":""}`)
+			event, _ = sjson.SetBytes(event, "item_id", call.itemID)
+			event, _ = sjson.SetBytes(event, "output_index", call.outputIndex)
+			event, _ = sjson.SetBytes(event, "delta", call.arguments[i:i+1])
+			messages = append(messages, string(event))
+		}
+	}
+	output := []byte(`[]`)
+	for _, call := range calls {
+		done := []byte(`{"type":"response.function_call_arguments.done","item_id":"","output_index":0,"arguments":""}`)
+		done, _ = sjson.SetBytes(done, "item_id", call.itemID)
+		done, _ = sjson.SetBytes(done, "output_index", call.outputIndex)
+		done, _ = sjson.SetBytes(done, "arguments", call.arguments)
+		messages = append(messages, string(done))
+		itemDone := []byte(`{"type":"response.output_item.done","output_index":0,"item":{"id":"","type":"function_call","call_id":"","name":"","arguments":""}}`)
+		itemDone, _ = sjson.SetBytes(itemDone, "output_index", call.outputIndex)
+		itemDone, _ = sjson.SetBytes(itemDone, "item.id", call.itemID)
+		itemDone, _ = sjson.SetBytes(itemDone, "item.call_id", call.callID)
+		itemDone, _ = sjson.SetBytes(itemDone, "item.name", call.name)
+		itemDone, _ = sjson.SetBytes(itemDone, "item.arguments", call.arguments)
+		messages = append(messages, string(itemDone))
+		output, _ = sjson.SetRawBytes(output, "-1", itemDone[len(`{"type":"response.output_item.done","output_index":0,"item":`):len(itemDone)-1])
+	}
+	completed := []byte(`{"type":"response.completed","response":{"id":"resp_1","object":"response","status":"completed","output":[]}}`)
+	completed, _ = sjson.SetRawBytes(completed, "response.output", output)
+	messages = append(messages, string(completed))
+	return messages
+}
+
+func collectCodexStream(t *testing.T, result *cliproxyexecutor.StreamResult) string {
+	t.Helper()
+	var all bytes.Buffer
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatalf("stream chunk error = %v", chunk.Err)
+		}
+		all.Write(chunk.Payload)
+	}
+	return all.String()
+}
+
+func assertCustomInputLifecycleStream(t *testing.T, stream string, want map[string]string) {
+	t.Helper()
+	deltas := make(map[string]*strings.Builder, len(want))
+	done := make(map[string]string, len(want))
+	items := make(map[string]string, len(want))
+	completed := make(map[string]string, len(want))
+	for itemID := range want {
+		deltas[itemID] = &strings.Builder{}
+	}
+	for _, block := range strings.Split(stream, "data:") {
+		data := strings.TrimSpace(block)
+		if !gjson.Valid(data) {
+			continue
+		}
+		switch gjson.Get(data, "type").String() {
+		case "response.custom_tool_call_input.delta":
+			itemID := gjson.Get(data, "item_id").String()
+			if builder := deltas[itemID]; builder != nil {
+				builder.WriteString(gjson.Get(data, "delta").String())
+			}
+		case "response.custom_tool_call_input.done":
+			done[gjson.Get(data, "item_id").String()] = gjson.Get(data, "input").String()
+		case "response.output_item.done":
+			items[gjson.Get(data, "item.id").String()] = gjson.Get(data, "item.input").String()
+		case "response.completed":
+			for _, item := range gjson.Get(data, "response.output").Array() {
+				completed[item.Get("id").String()] = item.Get("input").String()
+			}
+		}
+	}
+	for itemID, expected := range want {
+		if got := deltas[itemID].String(); got != expected {
+			t.Fatalf("%s deltas = %q, want %q; stream=%s", itemID, got, expected, stream)
+		}
+		if done[itemID] != expected || items[itemID] != expected || completed[itemID] != expected {
+			t.Fatalf("%s terminal = done:%q item:%q completed:%q, want %q; stream=%s", itemID, done[itemID], items[itemID], completed[itemID], expected, stream)
+		}
+	}
+}
