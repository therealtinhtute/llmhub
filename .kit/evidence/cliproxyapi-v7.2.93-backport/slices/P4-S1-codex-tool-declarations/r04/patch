+		],
+		"tool_choice":{"type":"function","namespace":"repo","name":"read"}
+	}`)
+
+	table, err := BuildResponsesToolDeclarationTable(request)
+	if err != nil {
+		t.Fatalf("BuildResponsesToolDeclarationTable() error = %v", err)
+	}
+	if len(table.declarations) != 5 {
