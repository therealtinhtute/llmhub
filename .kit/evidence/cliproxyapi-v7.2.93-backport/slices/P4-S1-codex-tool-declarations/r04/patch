+func TestResponsesToolDeclarationTableCustomInputFidelity(t *testing.T) {
+	tests := []struct {
+		name      string
+		arguments string
+		want      string
+	}{
+		{name: "raw brace", arguments: `{diff --git a/file b/file`, want: `{diff --git a/file b/file`},
+		{name: "incomplete wrapper", arguments: `{"input":"diff`, want: `{"input":"diff`},
+		{name: "raw object with input member", arguments: `{"input":"literal","other":1}`, want: `{"input":"literal","other":1}`},
+		{name: "exact wrapper fragmented through escapes", arguments: `{"input":"line\nquote:\" slash:\\"}`, want: "line\nquote:\" slash:\\"},
+		{name: "empty input", arguments: "", want: ""},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			table, err := BuildResponsesToolDeclarationTable([]byte(`{"tools":[{"type":"custom","name":"patch"}]}`))
+			if err != nil {
+				t.Fatalf("BuildResponsesToolDeclarationTable() error = %v", err)
+			}
+			table.RestoreResponsesToolCallEvents([]byte(`{"type":"response.output_item.added","output_index":3,"item":{"id":"fc_1","type":"function_call","call_id":"call_1","name":"patch","arguments":""}}`))
+
+			var events [][]byte
+			for i := range tt.arguments {
+				event := []byte(`{"type":"response.function_call_arguments.delta","item_id":"fc_1","output_index":3,"delta":""}`)
+				event, _ = sjson.SetBytes(event, "delta", tt.arguments[i:i+1])
+				events = append(events, table.RestoreResponsesToolCallEvents(event)...)
+			}
+			done := []byte(`{"type":"response.function_call_arguments.done","item_id":"fc_1","output_index":3,"arguments":""}`)
+			done, _ = sjson.SetBytes(done, "arguments", tt.arguments)
+			events = append(events, table.RestoreResponsesToolCallEvents(done)...)
+
+			var deltas strings.Builder
+			var doneInput string
+			for _, event := range events {
+				switch gjson.GetBytes(event, "type").String() {
+				case "response.custom_tool_call_input.delta":
+					if got := gjson.GetBytes(event, "item_id").String(); got != "ctc_1" {
+						t.Fatalf("delta item_id = %q, want ctc_1", got)
+					}
+					if got := gjson.GetBytes(event, "output_index").Int(); got != 3 {
+						t.Fatalf("delta output_index = %d, want 3", got)
+					}
+					deltas.WriteString(gjson.GetBytes(event, "delta").String())
+				case "response.custom_tool_call_input.done":
+					doneInput = gjson.GetBytes(event, "input").String()
+				}
+			}
+			if got := deltas.String(); got != tt.want {
+				t.Fatalf("custom input deltas = %q, want %q", got, tt.want)
+			}
+			if doneInput != tt.want {
+				t.Fatalf("custom input done = %q, want %q", doneInput, tt.want)
+			}
+		})
+	}
+}
