+
+func unwrapCustomToolInput(arguments string) string {
+	if input, exact, _ := inspectCustomToolInputWrapper(arguments); exact {
+		return input
+	}
+	return arguments
+}
+
+func responsesCustomToolInputDelta(arguments string, sent int, terminal, deferExact bool) (string, int) {
+	input, exact, possible := inspectCustomToolInputWrapper(arguments)
+	if possible && !terminal && (!exact || deferExact) {
+		return "", sent
+	}
+	output := arguments
+	if exact {
+		output = input
+	}
+	if sent > len(output) {
+		sent = 0
+	}
+	return output[sent:], len(output)
+}
+
+// inspectCustomToolInputWrapper distinguishes only the exact generated wrapper
+// shape from arbitrary freeform text. possible remains true for incomplete
+// prefixes so callers can defer emission until the shape becomes decidable.
+func inspectCustomToolInputWrapper(arguments string) (input string, exact, possible bool) {
+	i := skipCustomToolInputWhitespace(arguments, 0)
+	if i >= len(arguments) || arguments[i] != '{' {
+		return "", false, false
+	}
+	i = skipCustomToolInputWhitespace(arguments, i+1)
+	if i >= len(arguments) {
+		return "", false, true
+	}
+
+	keyEnd, complete, possible := scanCustomToolInputJSONString(arguments, i)
+	if !possible {
+		return "", false, false
+	}
+	if !complete {
+		return "", false, true
+	}
+	var key string
+	if json.Unmarshal([]byte(arguments[i:keyEnd]), &key) != nil || key != "input" {
+		return "", false, false
+	}
+	i = skipCustomToolInputWhitespace(arguments, keyEnd)
+	if i >= len(arguments) {
+		return "", false, true
+	}
+	if arguments[i] != ':' {
+		return "", false, false
+	}
+	i = skipCustomToolInputWhitespace(arguments, i+1)
+	if i >= len(arguments) {
+		return "", false, true
+	}
+
+	valueEnd, complete, possible := scanCustomToolInputJSONString(arguments, i)
+	if !possible {
+		return "", false, false
+	}
+	if !complete {
+		return "", false, true
+	}
+	if json.Unmarshal([]byte(arguments[i:valueEnd]), &input) != nil {
+		return "", false, false
+	}
+	i = skipCustomToolInputWhitespace(arguments, valueEnd)
+	if i >= len(arguments) {
+		return "", false, true
+	}
+	if arguments[i] != '}' {
+		return "", false, false
+	}
+	i = skipCustomToolInputWhitespace(arguments, i+1)
+	if i != len(arguments) {
+		return "", false, false
+	}
+	return input, true, true
+}
+
+func skipCustomToolInputWhitespace(value string, start int) int {
+	for start < len(value) {
+		switch value[start] {
+		case ' ', '\t', '\r', '\n':
+			start++
+		default:
+			return start
+		}
+	}
+	return start
+}
+
+func scanCustomToolInputJSONString(value string, start int) (end int, complete, possible bool) {
+	if start >= len(value) {
+		return start, false, true
+	}
+	if value[start] != '"' {
+		return start, false, false
+	}
+	for i := start + 1; i < len(value); i++ {
+		switch value[i] {
+		case '"':
+			return i + 1, true, true
+		case '\\':
+			i++
+			if i >= len(value) {
+				return len(value), false, true
+			}
+			switch value[i] {
+			case '"', '\\', '/', 'b', 'f', 'n', 'r', 't':
+			case 'u':
+				for digits := 0; digits < 4; digits++ {
+					i++
+					if i >= len(value) {
+						return len(value), false, true
+					}
+					if !isCustomToolInputHex(value[i]) {
+						return i, false, false
+					}
+				}
+			default:
+				return i, false, false
+			}
+		default:
+			if value[i] < 0x20 {
+				return i, false, false
+			}
+		}
+	}
+	return len(value), false, true
+}
+
+func isCustomToolInputHex(value byte) bool {
+	return value >= '0' && value <= '9' || value >= 'a' && value <= 'f' || value >= 'A' && value <= 'F'
+}
+
+func qualifyResponsesNamespaceToolName(namespaceName, childName string) string {
+	if childName == "" || namespaceName == "" || strings.HasPrefix(childName, "mcp__") {
+		return childName
+	}
+	if strings.HasSuffix(namespaceName, "__") {
+		return namespaceName + childName
+	}
+	return namespaceName + "__" + childName
+}
