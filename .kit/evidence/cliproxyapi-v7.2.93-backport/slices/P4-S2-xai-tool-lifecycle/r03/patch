+func qualifyXAINamespaceToolName(namespace, name string) string {
+	if namespace == "" || name == "" || strings.HasPrefix(name, "mcp__") {
+		return name
+	}
+	prefix := namespace
+	if !strings.HasSuffix(prefix, "__") {
+		prefix += "__"
+	}
+	if strings.HasPrefix(name, prefix) {
+		return name
+	}
+	return prefix + name
+}
